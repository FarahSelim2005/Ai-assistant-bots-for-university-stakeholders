# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=giu-bots
DB_USER=postgres
DB_PASSWORD=your-postgres-password

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Chat model for the Labs & Research agent
LABS_MODEL=provider/model-name
# Optional: tried automatically when LABS_MODEL fails (e.g. a free model hits its limit)
LABS_BACKUP_MODEL=provider/backup-model-name

# Model that can read images, used only when a user attaches a picture
VISION_MODEL=provider/vision-model-name
