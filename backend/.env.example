# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL. After migration 003 the app logs in as giu_app (row-level security), and
# migrations and the ingest script as the owner (DB_ADMIN_USER). Before 003: DB_USER=postgres
# and no DB_ADMIN_ lines.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=giu-bots
DB_USER=giu_app
DB_PASSWORD=your-giu-app-password
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=your-postgres-password
# Separate empty database for the database tests (never giu-bots); leave out to skip them.
TEST_DB_NAME=giu-bots-test

# "development" (on your own computer) allows *.localhost:5173 origins and the X-Tenant
# header. Leave it out or set "production" on a server.
APP_ENV=development

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Chat model for the Labs & Research agent
LABS_MODEL=provider/model-name
# Optional: tried automatically, in order, when LABS_MODEL fails (e.g. a free model
# hits its limit). Several models go on ONE line, separated by commas.
LABS_BACKUP_MODEL=provider/backup-model-one,groq/openai/gpt-oss-120b
# "ollama" runs OLLAMA_MODEL locally through Ollama (free, unlimited, slower).
OLLAMA_MODEL=gemma3:1b

# Optional: the Internship & Career agent's own model and backups (comma-separated).
# Empty: the same as LABS_MODEL / LABS_BACKUP_MODEL. Example: the fine-tuned local CV model.
CAREER_MODEL=ollama/giu-cv
CAREER_BACKUP_MODEL=groq/openai/gpt-oss-120b

# Model that can read images, used only when a user attaches a picture
VISION_MODEL=provider/vision-model-name
# Optional: backups for pictures, tried in order when VISION_MODEL fails (must accept images)
VISION_BACKUP_MODEL=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# Optional: models for the document editor (edit an attached .docx/.xlsx/.pptx/.pdf/.txt/.md).
# Empty: the same as LABS_MODEL / LABS_BACKUP_MODEL. Use a model that writes good JSON
# (not the fine-tuned CV model).
DOC_EDIT_MODEL=
DOC_EDIT_BACKUP_MODEL=

# The admin page (/admin) and the console (/console) use per-user logins: make accounts with
# python -m scripts.create_user (see README). ADMIN_PASSWORD is no longer used.

# Optional, for the voice call: fast and accurate Arabic/English speech-to-text
# (free key at https://console.groq.com). Without it, local Whisper is used (slower).
GROQ_API_KEY=gsk_your-groq-key-here
