# backend/.env on the AWS server. Copy to backend/.env and fill in. Never commit it.
# Replace 3-120-45-67 everywhere with your Elastic IP, dots written as dashes.

# Database (inside Docker; DB_HOST is set by docker-compose.yml)
DB_NAME=giu-bots
DB_USER=giu_app
DB_PASSWORD=choose-a-long-password-for-giu_app
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=choose-another-long-password

# Server mode: the X-Tenant header is ignored, the console asks for a login
APP_ENV=production

# Addresses: new universities get <slug>.PLATFORM_DOMAIN; links use https://
PLATFORM_DOMAIN=3-120-45-67.sslip.io
SITE_URL=https://{host}
# Every address Caddy gets a certificate for, comma-separated (one per university)
SITE_HOSTS=giu.3-120-45-67.sslip.io
ACME_EMAIL=you@example.com

# Models: copy these lines from your laptop's backend/.env
OPENROUTER_API_KEY=sk-or-v1-...
LABS_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LABS_BACKUP_MODEL=groq/openai/gpt-oss-120b
VISION_MODEL=
CAREER_MODEL=ollama/giu-cv
CAREER_BACKUP_MODEL=groq/openai/gpt-oss-120b
OLLAMA_MODEL=giu-cv
# Where giu-cv runs. Your laptop through Tailscale (see the deployment guide, Step 7):
# OLLAMA_BASE_URL=http://100.x.y.z:11434
GROQ_API_KEY=gsk_...

# Sign-up emails (Gmail: an app password, port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=UniBots <you@gmail.com>
